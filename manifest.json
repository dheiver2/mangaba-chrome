{
  "manifest_version": 3,
  "name": "Mangaba AI",
  "version": "2.1.1",
  "description": "Assistente brasileira no navegador: chat com contexto da página, agentes autônomos com deadlock detection, login/2FA automático e snapshot inteligente.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Mangaba AI"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs", "windows"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
